{
  "manifest_version": 3,
  "name": "FocusFlow AI",
  "version": "0.1.0",
  "description": "ADHD-friendly focus companion: tiny next steps, focus sessions, gentle distraction nudges and AI page summaries.",
  "action": {"default_title":"FocusFlow AI","default_popup":"index.html"},
  "permissions": ["storage","alarms","tabs","activeTab"],
  "host_permissions": ["http://localhost:5000/*","https://*/*"],
  "background": {"service_worker":"background.js"},
  "content_scripts": [{"matches":["<all_urls>"],"js":["content.js"],"run_at":"document_idle"}],
  "options_page": "index.html"
}
